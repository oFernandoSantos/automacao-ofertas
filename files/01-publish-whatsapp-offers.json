    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst startHour = parseInt($env.PUBLISH_WINDOW_START_HOUR || '8', 10);\nconst startMin = parseInt($env.PUBLISH_WINDOW_START_MIN || '0', 10);\nconst endHour = parseInt($env.PUBLISH_WINDOW_END_HOUR || '22', 10);\nconst endMin = parseInt($env.PUBLISH_WINDOW_END_MIN || '30', 10);\n\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: 'America/Sao_Paulo' }));\nconst minutesNow = now.getHours() * 60 + now.getMinutes();\nconst minutesStart = startHour * 60 + startMin;\nconst minutesEnd = endHour * 60 + endMin;\n\nconst withinWindow = minutesNow >= minutesStart && minutesNow <= minutesEnd;\nreturn [{ json: { ...item, _withinWindow: withinWindow } }];\n"
      },
