    {
      "parameters": {
        "jsCode": "const o = $input.first().json;\n\nfunction formatBRL(value) {\n  const n = Number(value);\n  if (isNaN(n)) return null;\n  return n.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });\n}\n\nconst price = formatBRL(o.price);\nconst originalPriceLine = o.original_price ? `De: ~${formatBRL(o.original_price)}~\\n` : '';\nconst discountLine = o.discount_percentage ? `🔻 ${o.discount_percentage}% OFF` : '';\nconst couponLine = o.coupon ? `🎟️ CUPOM: ${o.coupon}` : '';\nconst shippingLine = o.free_shipping === true ? '🚚 Frete grátis' : '';\nconst estimatedLine = o.estimated_final_price ? `💵 Pode chegar a ${formatBRL(o.estimated_final_price)} com o cupom.` : '';\n\nconst templates = {\n  MERCADO_LIVRE: `🔥 OFERTA NO MERCADO LIVRE!\\n\\n${o.title}\\n\\n${originalPriceLine}💰 Por: ${price}\\n\\n${discountLine}\\n${couponLine}\\n${shippingLine}\\n${estimatedLine}\\n\\n🛒 Comprar:\\n${o.link_to_publish}\\n\\n⚠️ Preço, estoque e promoção podem mudar.`,\n  SHOPEE: `🧡 ACHADO NA SHOPEE!\\n\\n${o.title}\\n\\n💸 ${price}\\n\\n${discountLine}\\n${couponLine}\\n\\n🛒 Ver oferta:\\n${o.link_to_publish}\\n\\n⚠️ Confira as condições da promoção no aplicativo/site.`,\n  AMAZON: `🛒 OFERTA NA AMAZON!\\n\\n${o.title}\\n\\n💰 ${price}\\n\\n${discountLine}\\n${couponLine}\\n\\n👉 Ver oferta:\\n${o.link_to_publish}\\n\\n⚠️ Preço e disponibilidade podem mudar.`\n};\n\nlet message = templates[o.marketplace] || templates.MERCADO_LIVRE;\n// remove linhas em branco duplicadas geradas por campos opcionais ausentes\nmessage = message.split('\\n').filter((l, idx, arr) => !(l.trim() === '' && arr[idx-1] && arr[idx-1].trim() === '')).join('\\n');\n\nreturn [{ json: { ...o, message } }];\n"
      },
