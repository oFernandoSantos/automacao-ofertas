    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst ALLOWED_DOMAINS = {\n  MERCADO_LIVRE: ['mercadolivre.com.br','mercadolivre.com','mercadolibre.com'],\n  SHOPEE: ['shopee.com.br','shope.ee'],\n  AMAZON: ['amazon.com.br','amzn.to']\n};\n// domínios oficiais de encurtamento/redirecionamento próprios cadastrados\nconst OWN_TRACKING_DOMAINS = (($env.TRACKING_ALLOWED_DOMAINS || 'meusite.com').split(','));\n\nconst affiliateUrl = item.affiliate_url;\nconst trackingUrl = item.tracking_url;\nconst marketplace = item.marketplace;\n\nif (!affiliateUrl) {\n  return [{ json: { ...item, _linkValid: false, _linkError: 'affiliate_url ausente - ABORTAR' } }];\n}\n\nfunction hostOf(u) { try { return new URL(u).hostname.replace('www.',''); } catch(e) { return null; } }\n\nconst affHost = hostOf(affiliateUrl);\nconst allowedForMarketplace = ALLOWED_DOMAINS[marketplace] || [];\nconst affHostOk = affHost && allowedForMarketplace.some(d => affHost === d || affHost.endsWith('.' + d));\n\nif (!affHostOk) {\n  return [{ json: { ...item, _linkValid: false, _linkError: 'affiliate_url com domínio não permitido: ' + affHost } }];\n}\n\n// link publicado: preferir tracking_url, validado contra domínios próprios cadastrados\nlet linkToPublish = affiliateUrl;\nif (trackingUrl) {\n  const trkHost = hostOf(trackingUrl);\n  const trkHostOk = trkHost && OWN_TRACKING_DOMAINS.some(d => trkHost === d.trim() || trkHost.endsWith('.' + d.trim()));\n  if (trkHostOk) linkToPublish = trackingUrl;\n}\n\nreturn [{ json: { ...item, _linkValid: true, link_to_publish: linkToPublish } }];\n"
      },
