      "typeVersion": 4.2,
      "position": [
        500,
        400
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CREDENTIAL_ID",
          "name": "Backend API Header Auth"
        }
      }
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "mergeByPosition",
        "numberInputs": 3,
        "options": {}
      },
      "id": "89c24328-4f3f-4b2e-8c70-5183a2689a32",
      "name": "Consolidar Status",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        750,
        250
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst backend = items[0] ? items[0].json : {};\nconst evolution = items[1] ? items[1].json : {};\nconst lastPub = items[2] ? items[2].json : {};\nreturn [{ json: {\n  checked_at: new Date().toISOString(),\n  backend_api_ok: (backend.statusCode || 500) < 300,\n  evolution_api_ok: (evolution.statusCode || 500) < 300,\n  whatsapp_state: evolution.body ? evolution.body.state : null,\n  last_publication: lastPub.body || null\n} }];\n"
      },
      "id": "2d5f045b-9e28-4891-a9e6-b0814f5304fc",
      "name": "Montar Relatório de Saúde",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        250
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.BACKEND_API_URL}}/api/automation/health",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{$json}}",
        "options": {}
      },
      "id": "f33cc992-7f96-4ccc-9e83-6b2cb0f217d6",
      "name": "Salvar Status no Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1250,
        250
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "CREDENTIAL_ID",
          "name": "Backend API Header Auth"
        }
      }
    }
